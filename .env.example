# Database Configuration
DATABASE_URL=postgres://inventory_user:inventory_password@localhost:5432/inventory_db?sslmode=disable

# Server Configuration
SERVER_PORT=8080
SERVER_HOST=0.0.0.0

# Logging Configuration
LOG_LEVEL=info
LOG_FORMAT=json

# OAuth 2.0 / OIDC Configuration (required by `inventory serve`)
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=
OAUTH_AUTH_URL=
OAUTH_TOKEN_URL=
OAUTH_REDIRECT_URL=http://localhost:8080/callback
# Space-separated; defaults to "openid profile email" when unset
OAUTH_SCOPES=
# Comma-separated issuer URLs used for ID token verification
ALLOWED_ISSUERS=
# Secret used to sign session JWTs (generate with: openssl rand -base64 32)
SESSION_SECRET=

# Environment
ENVIRONMENT=development
